--- a/drivers/leds/Kconfig
+++ b/drivers/leds/Kconfig
@@ -410,6 +410,21 @@
 	  defined as platform devices and/or OpenFirmware platform devices.
 	  The code to use these bindings can be selected below.
 
+config LEDS_GPIO_PWM
+	tristate "LED Support for GPIO LEDs with software PWM brightness"
+	depends on LEDS_CLASS
+	depends on GPIOLIB
+	help
+	  This option enables support for LEDs connected to GPIO outputs
+	  with software PWM brightness control (0-255).  Brightness is
+	  generated by a jiffies-based timer_list, so it runs on a periodic
+	  tick and needs no high-resolution timers, for SoCs that lack a
+	  hardware PWM controller (e.g. Realtek RTL8196E).
+
+	  DTS compatible: "gpio-leds-pwm".  Child nodes use the documented
+	  gpio-leds-like subset.  The GPIO provider must not sleep because
+	  PWM edges run from timer softirq context.
+
 config LEDS_LP3944
 	tristate "LED Support for N.S. LP3944 (Fun Light) I2C chip"
 	depends on LEDS_CLASS
