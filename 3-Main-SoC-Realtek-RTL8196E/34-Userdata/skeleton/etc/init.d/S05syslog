#!/bin/sh
#
# S05syslog - Start/stop minimal syslogd and klogd (BusyBox)
#
# Provides system logging services via BusyBox syslogd/klogd
# Can be disabled by creating /etc/nosyslog file
#
# Author: J. Nilo - May 2025
#

# Timestamps are rendered in the local timezone, so /var/log/messages lines up
# with whatever an incident gets correlated against — the login shell, a home
# automation history, a capture taken on another host. Two things are needed
# for that, and neither works on its own:
#
#   - TZ has to be in syslogd's own environment. Only /etc/profile exports it,
#     and only for login shells; init runs each S* script in a separate shell,
#     so a daemon started here inherits nothing and falls back to UTC.
#   - -t has to strip client-supplied timestamps. syslog(3) embeds its own
#     timestamp in the message, and without -t syslogd copies that verbatim
#     instead of stamping the line itself — so every line written by a daemon
#     would keep the client's rendering and ignore the TZ set above. Checked
#     on the bench: with -t, even a client forced to TZ=UTC is restamped local.
#
# The cost is the one-hour fold at the DST fallback. Kernel lines still carry
# the monotonic [ seconds ] prefix, which disambiguates those.

[ "$INIT_VERBOSE" = "0" ] && exec >/dev/null

# Check if /etc/nosyslog file exists
if [ -f /etc/nosyslog ]; then
    echo "  syslog: skipped (/etc/nosyslog present)"
    exit 0
fi

case "$1" in
start)
    [ -f /etc/TZ ] && export TZ=$(cat /etc/TZ)
    # syslogd reads the hostname once, before forking, and stamps every line
    # with that copy for as long as it runs. It starts here, ahead of
    # S15hostname, so without this the entire log reads "(none)" — the kernel's
    # compiled-in default — for the whole uptime, which makes a log useless the
    # moment two gateways are read side by side. Setting it here rather than
    # reordering the scripts keeps the ordering constraint where it belongs:
    # S15hostname still owns /etc/hosts, which needs an IP this early script
    # does not have yet. Re-running hostname there is harmless.
    [ -f /etc/hostname ] && hostname -F /etc/hostname
    echo "  syslog: started (syslogd + klogd)"
    # Ring of 6 x 64 KB in RAM. At the rate of a busy OTBR site (a few dozen
    # otbr-agent warnings per day) that keeps about two weeks, enough for the
    # supervisor's "exited/died, restarting" line to survive until someone
    # looks. The former 3 x 32 KB rotated an event out in under four days.
    syslogd -O /var/log/messages -s 64 -b 5 -m 0 -t
    klogd &
    ;;
stop)
    echo "  syslog: stopped"
    killall syslogd
    killall klogd
    ;;
esac
