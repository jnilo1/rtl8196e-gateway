# Host-side gateway configuration (see gateway.env.example, tracked).
# gateway.env is hand-written and personal; .gateway-state is written by the
# flash scripts to remember the address they last provisioned or reached.
gateway.env
.gateway-state
.gateway-state.*

# Docker .env rendered by flash_userdata.sh with the gateway's address, so the
# compose files stay generic and the working tree stays clean.
2-Zigbee-Radio-Silabs-EFR32/26-OT-RCP/docker/.env
3-Main-SoC-Realtek-RTL8196E/32-Kernel/*.sha256sums
