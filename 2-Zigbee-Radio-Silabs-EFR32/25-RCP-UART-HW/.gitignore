# Cloned source repositories
cpcd/cpc-daemon/
zigbeed/simplicity_sdk/

# Work in progress (not ready for release)
cpcd-rtl8196e/

# Test files
cpcd/test_tcp
cpcd/test_tcp.c

# Runtime data (user-specific)
zigbeed/host_token.nvm
zigbeed/tmp/

# Keep RCP firmware for users who just want to flash. Only the .gbl is shipped:
# the .s37 is a side-effect of the build (the SWD/J-Link image), and stays
# ignored by the root rule like every other .s37 in the tree.
!firmware/
!firmware/*.gbl
