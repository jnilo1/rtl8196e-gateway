# cpcd + zigbeed container for Lidl Silvercrest Gateway RCP
# Multi-architecture build (amd64, arm64)
#
# Build strategy (like Nerivec):
#   - Stage 1 (generator): x86_64 only - runs slc-cli to generate makefiles for all architectures
#   - Stage 2 (builder): native on each arch - compiles cpcd and zigbeed
#   - Stage 3 (runtime): minimal image with binaries
#
# Versions:
#   - cpcd: v4.6.2 (from GitHub cpc-daemon)
#   - zigbeed: EmberZNet 8.2.2 / EZSP 18 (from Simplicity SDK 2025.6.3)
#
# Architecture:
#   TCP:8888 (gateway) -> cpcd (native TCP bus) -> zigbeed -> TCP:9999 (Z2M)

# ============================================================
# Stage 1: Generator (x86_64 only)
# Generates zigbeed project files for all target architectures
# slc-cli is only available for x86_64
# ============================================================
# Empty by default. A folder holding slc_cli_linux.zip replaces it with
#   --build-context slc_cli=<folder>
# (see the slc-cli step below).
FROM scratch AS slc_cli

ARG BUILDPLATFORM
FROM --platform=${BUILDPLATFORM} ubuntu:24.04 AS generator

ARG DEBIAN_FRONTEND=noninteractive
ARG SIMPLICITY_SDK_VERSION=v2025.6.3

# Install dependencies for slc-cli
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    python3 \
    openjdk-21-jre-headless \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Download Simplicity SDK
RUN curl -fsSL -o /tmp/simplicity-sdk.zip \
    "https://github.com/SiliconLabs/simplicity_sdk/releases/download/${SIMPLICITY_SDK_VERSION}/simplicity-sdk.zip" \
    && mkdir -p /opt/simplicity_sdk \
    && (unzip -q /tmp/simplicity-sdk.zip -d /opt/simplicity_sdk || true) \
    && rm /tmp/simplicity-sdk.zip

ENV SIMPLICITY_SDK=/opt/simplicity_sdk

COPY zigbeed/serial_adapter_posix.c /opt/jnilo1-zigbeed/serial_adapter_posix.c
COPY zigbeed/serial_adapter_posix.h /opt/jnilo1-zigbeed/serial_adapter_posix.h
COPY zigbeed/install_serial_adapter.sh /opt/jnilo1-zigbeed/install_serial_adapter.sh
RUN chmod +x /opt/jnilo1-zigbeed/install_serial_adapter.sh

# slc-cli (x86_64 only) generates the zigbeed makefiles for both architectures.
# silabs.com refuses command-line downloads (403 since 2026-10-22), so the
# archive can be supplied as a named build context, a folder holding
# slc_cli_linux.zip (a BuildKit secret cannot: they are capped at 500 KiB):
#   --build-context slc_cli=<folder>
# Without it, the download is tried as before. The folder is mounted read-only
# for this RUN only, and slc-cli is unpacked, used and deleted inside it, its
# user.home redirected to /tmp, so no layer ever holds it: the CI exports every
# intermediate layer to the GitHub Actions cache (cache-to mode=max).
RUN --mount=type=bind,from=slc_cli,target=/tmp/slc-in \
    set -e; \
    if [ -s /tmp/slc-in/slc_cli_linux.zip ]; then \
        echo "slc-cli: using the archive from the slc_cli build context"; \
        cp /tmp/slc-in/slc_cli_linux.zip /tmp/slc.zip; \
    else \
        curl -fsSL "https://www.silabs.com/documents/login/software/slc_cli_linux.zip" -o /tmp/slc.zip || { \
            echo "ERROR: could not download slc_cli_linux.zip; silabs.com may refuse command-line downloads."; \
            echo "Download it in a browser, put it in a folder and pass that folder:"; \
            echo "  --build-context slc_cli=<folder>"; \
            exit 1; }; \
    fi; \
    mkdir -p /tmp/slc; \
    unzip -q /tmp/slc.zip -d /tmp/slc; \
    rm /tmp/slc.zip; \
    SLC=/tmp/slc/slc_cli/slc; \
    chmod +x "$SLC"; \
    export JAVA_TOOL_OPTIONS="-Duser.home=/tmp/slc-home"; \
    "$SLC" signature trust --sdk "${SIMPLICITY_SDK}" 2>/dev/null || true; \
    for target in amd64:zigbee_x86_64 arm64:zigbee_arm64; do \
        dir="/generated/${target%%:*}"; \
        mkdir -p "$dir"; \
        cd "$dir"; \
        cp "${SIMPLICITY_SDK}/protocol/zigbee/app/projects/zigbeed"/*.c .; \
        cp "${SIMPLICITY_SDK}/protocol/zigbee/app/projects/zigbeed"/*.h .; \
        cp "${SIMPLICITY_SDK}/protocol/zigbee/app/projects/zigbeed/zigbeed.slcp" .; \
        "$SLC" generate zigbeed.slcp \
            --sdk "${SIMPLICITY_SDK}" \
            --with="${target#*:},linux_arch_64" \
            --without=zigbee_recommended_linux_arch \
            -o makefile \
            --force 2>&1 | tail -5; \
        /opt/jnilo1-zigbeed/install_serial_adapter.sh "$dir"; \
        rm -rf simplicity_sdk_*; \
        ln -s "${SIMPLICITY_SDK}" simplicity_sdk_2025.6.3; \
    done; \
    rm -rf /tmp/slc /tmp/slc-home

# ============================================================
# Stage 2: Builder (multi-arch native compilation)
# ============================================================
FROM ubuntu:24.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG CPCD_VERSION=v4.6.2
ARG TARGETARCH

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    ca-certificates \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Build cpcd from GitHub (native compilation), patched with the native TCP bus.
# tcp-bus.patch adds bus_type: TCP so cpcd dials the gateway's UART<->TCP bridge
# directly — no socat-cpc PTY shim. Same v4.6.2 clone + same patch as the native
# build_cpcd.sh, so the image's cpcd matches the host-built one.
COPY cpcd/tcp-bus.patch /tmp/tcp-bus.patch
RUN git clone --depth 1 --branch ${CPCD_VERSION} https://github.com/SiliconLabs/cpc-daemon.git \
    && cd cpc-daemon \
    && git apply /tmp/tcp-bus.patch \
    && mkdir build && cd build \
    && cmake .. \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_BUILD_TYPE=Release \
        -DENABLE_ENCRYPTION=OFF \
    && make -j$(nproc) \
    && make install \
    && make install DESTDIR=/install \
    && ldconfig

# Copy SDK from generator (needed for headers and libs)
COPY --from=generator /opt/simplicity_sdk /opt/simplicity_sdk

# Copy generated zigbeed project for this architecture
# TARGETARCH is 'amd64' or 'arm64'
COPY --from=generator /generated/${TARGETARCH} /build/zigbeed

WORKDIR /build/zigbeed

# Build zigbeed (native compilation)
RUN make -f zigbeed.Makefile -j$(nproc)

# Install to staging directory
RUN mkdir -p /install/usr/local/bin && \
    cp build/debug/zigbeed /install/usr/local/bin/ && \
    chmod +x /install/usr/local/bin/zigbeed

# Strip binaries to reduce image size
RUN strip /install/usr/local/bin/zigbeed /install/usr/local/bin/cpcd

# ============================================================
# Stage 3: Runtime image
# ============================================================
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    supervisor \
    netcat-openbsd \
    gettext-base \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Copy binaries from builder
COPY --from=builder /install/usr/local /usr/local

# Update library cache
RUN ldconfig

# Create directories
RUN mkdir -p /etc/cpcd /var/lib/zigbeed /run/cpcd /var/log/supervisor \
    /usr/share/doc/zigbeed

# License notice for the OpenThread-derived mainloop integration.
COPY zigbeed/THIRD_PARTY_NOTICES /usr/share/doc/zigbeed/THIRD_PARTY_NOTICES

# Copy configuration files
COPY docker/cpcd-zigbeed/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/cpcd-zigbeed/cpcd.conf.template /etc/cpcd/cpcd.conf.template
COPY docker/cpcd-zigbeed/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Environment variables with defaults. No UART knobs here: cpcd uses its
# native TCP bus (the gateway's in-kernel bridge owns baud and flow control,
# armed from radio.conf at boot).
ENV RCP_HOST=192.168.1.1
ENV RCP_PORT=8888
ENV CPCD_INSTANCE=cpcd_0
ENV ZIGBEED_PORT=9999
ENV ZIGBEED_DEBUG=0
ENV ZIGBEED_IID=1
ENV CPC_BROADCAST_IID=0
ENV ZIGBEED_BIND=0.0.0.0

# Expose port for Z2M connection
EXPOSE 9999

# Health check: do not connect to the single-client EZSP port. Confirm CPCd
# and Zigbeed processes plus a listener on ZIGBEED_PORT through /proc instead.
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD pgrep -x cpcd >/dev/null && pgrep -x zigbeed >/dev/null && { p=$(printf "%04X" "$ZIGBEED_PORT"); grep -qiE ":$p [0-9A-F:]+ 0A " /proc/net/tcp /proc/net/tcp6 2>/dev/null; }

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
