# rcp-stack configuration
# Copy to ~/.config/rcp-stack/rcp-stack.env and edit

# =============================================================================
# REQUIRED: RCP endpoint exposed by the in-kernel UART bridge on the gateway
# =============================================================================
RCP_ENDPOINT=tcp://192.168.1.100:8888

# =============================================================================
# REQUIRED: Command lines for each service
# =============================================================================
# Use these variables in your commands:
# - $CPC_INSTANCE_NAME  -> cpcd_bringup
# - $CPC_SOCKET_DIR     -> /dev/shm/cpcd/cpcd_bringup
# - $CPCD_CONF          -> ~/.config/rcp-stack/cpcd.conf
# - $ZIGBEED_LISTEN     -> tcp-listen://127.0.0.1:9999

CPCD_COMMAND='cpcd -c "$HOME/.config/rcp-stack/cpcd.conf"'
ZIGBEED_COMMAND='zigbeed -r "spinel+cpc://$CPC_INSTANCE_NAME?iid=1&iid-list=0" -p "$ZIGBEED_LISTEN"'
# Zigbee2MQTT connects to zigbeed with serial.port: tcp://localhost:9999
Z2M_COMMAND='zigbee2mqtt'

# =============================================================================
# OPTIONAL: Override defaults
# =============================================================================
# CPC_INSTANCE_NAME=cpcd_bringup
# CPC_SOCKET_DIR=/dev/shm/cpcd/cpcd_bringup
# ZIGBEED_LISTEN=tcp-listen://127.0.0.1:9999
# CPCD_CONF=$HOME/.config/rcp-stack/cpcd.conf
# READY_TIMEOUT=20
# READY_POLL_INTERVAL=0.2
