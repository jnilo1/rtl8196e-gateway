#!/usr/bin/env bash
set -euo pipefail

# cpcd 4.5.3 ignores a socket_folder key: it always creates its sockets in
# /dev/shm/cpcd/<instance_name>/ (compiled-in CPC_SOCKET_DIR). What must agree
# with rcp-stack is therefore the instance name, and CPC_SOCKET_DIR must be the
# directory cpcd will actually use.

conf="${CPCD_CONF:-$HOME/.config/rcp-stack/cpcd.conf}"
instance="${CPC_INSTANCE_NAME:-cpcd_bringup}"
socket_dir="${CPC_SOCKET_DIR:-/dev/shm/cpcd/$instance}"

if [ ! -f "$conf" ]; then
  echo "warn: cpcd config not found: $conf" >&2
  exit 0
fi

# Value of a top-level "key: value" line, without comment, spaces or quotes.
conf_value() {
  local v
  v="$(sed -n "s/^[[:space:]]*$1:[[:space:]]*//p" "$conf" | head -n 1)"
  v="${v%%#*}"
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
  printf '%s' "$v"
}

conf_instance="$(conf_value instance_name)"
if [ -n "$conf_instance" ] && [ "$conf_instance" != "$instance" ]; then
  echo "error: cpcd.conf instance_name ($conf_instance) does not match CPC_INSTANCE_NAME ($instance)." >&2
  exit 1
fi

cpcd_dir="/dev/shm/cpcd/${conf_instance:-cpcd_0}"
if [ "$socket_dir" != "$cpcd_dir" ]; then
  echo "error: CPC_SOCKET_DIR ($socket_dir) is not where cpcd creates its sockets ($cpcd_dir)." >&2
  exit 1
fi

if [ -n "$(conf_value socket_folder)" ]; then
  echo "warn: cpcd.conf sets socket_folder, which cpcd ignores; sockets go to $cpcd_dir." >&2
fi
